{
  "name": "qterminal",
  "version": "1.0.0",
  "description": "Local-first AI-native knowledge and research workspace",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "prepare:pdf": "node scripts/prepare-pdf-worker.cjs",
    "dev": "npm run prepare:pdf && concurrently -k \"npm:dev:web\" \"npm:dev:desktop\"",
    "dev:web": "next dev",
    "dev:desktop": "wait-on tcp:3000 && cross-env ELECTRON_START_URL=http://localhost:3000 node electron/launch.cjs",
    "build": "npm run prepare:pdf && next build",
    "start": "node electron/launch.cjs",
    "desktop:preview": "npm run build && node electron/launch.cjs",
    "desktop:dist": "npm run build && electron-builder",
    "test:m72:live": "node scripts/m72-live-proof.cjs",
    "test:m74:live": "node scripts/m72-live-proof.cjs",
    "test": "node --experimental-strip-types --test electron/*.test.cjs electron/ai/*.test.cjs electron/ai/providers/*.test.cjs lib/*.test.cjs features/chat/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "test:chat:live": "node scripts/chat-live-acceptance.cjs",
    "test:dataset:live": "node scripts/dataset-live-acceptance.cjs",
    "test:dataset:electron": "npm run build && node scripts/dataset-electron-acceptance.cjs",
    "test:chat:online": "node scripts/chat-live-acceptance.cjs --gemini",
    "test:chat:online:electron": "npm run build && node scripts/electron-online-chat-smoke.cjs",
    "test:agent:electron": "npm run build && node scripts/agent-electron-acceptance.cjs",
    "test:chat:electron": "npm run build && node scripts/electron-chat-smoke.cjs",
    "format:integration": "prettier --write \"features/**/*.{ts,tsx,cjs,css}\" \"electron/ai/**/*.cjs\" electron/main.cjs electron/preload.cjs types/ai.ts types/electron.d.ts components/app-shell.tsx components/chat-panel.tsx components/top-bar.tsx \"scripts/*chat*.cjs\" scripts/electron-smoke-main.cjs",
    "format:check": "prettier --check \"features/**/*.{ts,tsx,cjs,css}\" \"electron/ai/**/*.cjs\" electron/main.cjs electron/preload.cjs types/ai.ts types/electron.d.ts components/app-shell.tsx components/chat-panel.tsx components/top-bar.tsx \"scripts/*chat*.cjs\" scripts/electron-smoke-main.cjs",
    "test:chat:openrouter:electron": "npm run build && node scripts/electron-openrouter-smoke.cjs",
    "test:agent:workspace:electron": "npm run build && node scripts/electron-agent-workspace-smoke.cjs",
    "test:usage:electron": "npm run build && node scripts/electron-usage-monitor-smoke.cjs",
    "test:victoria:electron": "npm run build && node scripts/electron-victoria-smoke.cjs",
    "test:ui-polish:electron": "npm run build && node scripts/electron-ui-polish-smoke.cjs",
    "test:surfaces:electron": "npm run build && node scripts/electron-soft-surfaces-smoke.cjs",
    "test:chronoz:electron": "npm run build && node scripts/electron-chronoz-smoke.cjs",
    "test:startup:electron": "npm run build && node scripts/electron-startup-smoke.cjs",
    "test:knowledge:electron": "npm run build && node scripts/electron-knowledge-smoke.cjs",
    "test:construction:electron": "npm run build && node scripts/electron-construction-smoke.cjs",
    "test:appearance:electron": "npm run build && node scripts/electron-appearance-smoke.cjs",
    "test:box-agents:electron": "npm run build && node scripts/electron-box-agents-smoke.cjs",
    "test:add-agent:electron": "npm run build && node scripts/electron-add-agent-smoke.cjs",
    "test:single-file:electron": "npm run build && node scripts/electron-single-file-smoke.cjs",
    "test:message-retry:electron": "npm run build && node scripts/electron-message-retry-smoke.cjs",
    "test:pdf-image:electron": "npm run build && node scripts/electron-pdf-image-smoke.cjs",
    "test:runtime-kernel:electron": "npm run build && node scripts/electron-runtime-kernel-smoke.cjs",
    "report:runtime-kernel": "node scripts/runtime-kernel-report.cjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.63.0",
    "postcss": "^8.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "asarUnpack": [
      "electron/windows-ocr.ps1"
    ],
    "appId": "com.wonnyy.amadeus",
    "productName": "QTerminal",
    "files": [
      "out/**/*",
      "electron/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
