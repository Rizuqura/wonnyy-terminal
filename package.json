{
  "name": "wonnyy-amadeus",
  "version": "0.0.1",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "prepare:pdf": "node scripts/prepare-pdf-worker.cjs",
    "dev": "npm run prepare:pdf && concurrently -k \"npm:dev:web\" \"npm:dev:desktop\"",
    "dev:web": "next dev",
    "dev:desktop": "wait-on tcp:3000 && cross-env ELECTRON_START_URL=http://localhost:3000 node electron/launch.cjs",
    "build": "npm run prepare:pdf && next build",
    "start": "node electron/launch.cjs",
    "desktop:preview": "npm run build && node electron/launch.cjs",
    "desktop:dist": "npm run build && electron-builder",
    "test": "node --experimental-strip-types --test electron/vault-service.test.cjs electron/station-service.test.cjs lib/planet-layout.test.cjs lib/planet-hit-testing.test.cjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "postcss": "^8.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.wonnyy.amadeus",
    "productName": "Wonnyy",
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
